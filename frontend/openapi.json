{"openapi": "3.1.0", "info": {"title": "Agile Metrics Forecast API", "version": "0.1.0"}, "paths": {"/api/forecast": {"post": {"summary": "Post Forecast", "operationId": "post_forecast_api_forecast_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ForecastRequestBody"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ForecastResult"}}}}, "400": {"description": "Invalid input", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponseBody"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"ErrorResponseBody": {"properties": {"error": {"type": "string", "title": "Error"}}, "type": "object", "required": ["error"], "title": "ErrorResponseBody", "description": "The JSON body returned on any validation failure."}, "ForecastRequestBody": {"properties": {"history": {"items": {"type": "integer"}, "type": "array", "title": "History"}, "period_days": {"type": "integer", "title": "Period Days"}, "backlog_size": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Backlog Size"}, "target_date": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "Target Date"}, "seed": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Seed"}}, "type": "object", "required": ["history", "period_days"], "title": "ForecastRequestBody", "description": "The JSON body `POST /api/forecast` accepts (contracts/forecast-api.md)."}, "ForecastResult": {"properties": {"outcomes": {"additionalProperties": {"anyOf": [{"type": "string", "format": "date"}, {"type": "integer"}]}, "type": "object", "title": "Outcomes"}, "trials_run": {"type": "integer", "title": "Trials Run"}, "periods_used": {"type": "integer", "title": "Periods Used"}}, "type": "object", "require