{"openapi": "3.1.0", "info": {"title": "Agile Metrics Forecast API", "version": "0.1.0"}, "paths": {"/api/forecast": {"post": {"summary": "Post Forecast", "operationId": "post_forecast_api_forecast_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ForecastRequestBody"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ForecastResponseBody"}}}}, "400": {"description": "Invalid input", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponseBody"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/forecast/csv": {"post": {"summary": "Post Forecast Csv", "description": "A CSV-dedicated endpoint (contracts/forecast-api.md), separate from\n`POST /api/forecast` - `multipart/form-data` so a real file upload needs\nno client-side text conversion (plan.md \"Decisions confirmed\" \u00a71).", "operationId": "post_forecast_csv_api_forecast_csv_post", "requestBody": {"content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/Body_post_forecast_csv_api_forecast_csv_post"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ForecastResponseBody"}}}}, "400": {"description": "Invalid input", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponseBody"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"Body_post_forecast_csv_api_forecast_csv_post": {"properties": {"period_days": {"type": "integer", "title": "Period Days"}, "backlog_size": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Backlog Size"}, "target_date": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "Target Date"}, "seed": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Seed"}, "csv_file": {"anyOf": [{"type": "string", "contentMediaType": "application/octet-stream"}, {"type": "null"}], "title": "Csv File"}, "csv_text": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Csv Text"}}, "type": "object", "required": ["period_days"], "title": "Body_post_forecast_csv_api_forecast_csv_post"}, "CycleTimeEntry": {"properties": {"key": {"type": "string", "title": "Key"}, "started_at": {"type": "string", "format": "date", "title": "Started At"}, "resolved_at": {"type": "string", "format": "date", "title": "Resolved At"}}, "type": "object", "required": ["key", "started_at", "resolved_at"], "title": "CycleTimeEntry", "description": "One resolved Jira issue's duration from its first in-progress transition to\nits resolution (spec 011 data-model.md). Exists only for issues with a known\nstart - an issue that skipped \"in progress\" entirely is excluded upstream, not\nrepresented here with a missing or zero duration."}, "ErrorResponseBody": {"properties": {"error": {"type": "string", "title": "Error"}}, "type": "object", "required": ["error"], "title": "ErrorResponseBody", "description": "The JSON body returned on any validation failure."}, "FlowMetrics": {"properties": {"cycle_time": {"items": {"$ref": "#/components/schemas/CycleTimeEntry"}, "type": "array", "title": "Cycle Time"}, "wip": {"items": {"$ref": "#/components/schemas/WipSnapshot"}, "type": "array", "title": "Wip"}, "flow_state_counts": {"items": {"$ref": "#/components/schemas/FlowStateCount"}, "type": "array", "title": "Flow State Counts"}, "excluded_count": {"type": "integer", "minimum": 0.0, "title": "Excluded Count"}, "capped_count": {"type": "integer", "minimum": 0.0, "title": "Capped Count"}, "cycle_time_percentiles": {"anyOf": [{"additionalProperties": {"type": "integer"}, "type": "object"}, {"type": "null"}], "title": "Cycle Time Percentiles"}}, "type": "object", "required": ["cycle_time", "wip", "flow_state_counts", "excluded_count", "capped_count"], "title": "FlowMetrics", "description": "Cycle-time, aging-WIP, and cumulative-flow views for one Jira request (spec\n011 data-model.md). A read-only, retrospective view - never consumed by\n`forecast_by_items`/`forecast_by_date` (Constitution Principle II)."}, "FlowStateCount": {"properties": {"day": {"type": "string", "format": "date", "title": "Day"}, "not_started": {"type": "integer", "minimum": 0.0, "title": "Not Started"}, "in_progress": {"type": "integer", "minimum": 0.0, "title": "In Progress"}, "done": {"type": "integer", "minimum": 0.0, "title": "Done"}}, "type": "object", "required": ["day", "not_started", "in_progress", "done"], "title": "FlowStateCount", "description": "One day's count of tracked issues in each of the three flow bands (spec 011)."}, "ForecastRequestBody": {"properties": {"history": {"anyOf": [{"items": {"type": "integer"}, "type": "array"}, {"type": "null"}], "title": "History"}, "period_days": {"type": "integer", "title": "Period Days"}, "backlog_size": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Backlog Size"}, "target_date": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "Target Date"}, "seed": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Seed"}, "linear_api_key": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Linear Api Key"}, "linear_team_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Linear Team Id"}, "linear_periods": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Linear Periods"}, "jira_site": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Jira Site"}, "jira_email": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Jira Email"}, "jira_api_token": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Jira Api Token"}, "jira_project_key": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Jira Project Key"}, "jira_periods": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Jira Periods"}}, "type": "object", "required": ["period_days"], "title": "ForecastRequestBody", "description": "The JSON body `POST /api/forecast` accepts (contracts/forecast-api.md).\n\n`history` is optional - exactly one of it, or both `linear_api_key` and\n`linear_team_id`, is required (spec 006; enforced in `_compute_forecast`,\nmatching the existing `backlog_size`/`target_date` \"exactly one of\"\npattern rather than a separate pydantic validator)."}, "ForecastResponseBody": {"properties": {"outcomes": {"additionalProperties": {"anyOf": [{"type": "string", "format": "date"}, {"type": "integer"}]}, "type": "object", "title": "Outcomes"}, "trials_run": {"type": "integer", "title": "Trials Run"}, "periods_used": {"type": "integer", "title": "Periods Used"}, "reference_date": {"type": "string", "format": "date", "title": "Reference Date"}, "distribution": {"items": {"$ref": "#/components/schemas/OutcomeBucket"}, "type": "array", "title": "Distribution"}, "projection": {"items": {"$ref": "#/components/schemas/ProjectionPoint"}, "type": "array", "title": "Projection"}, "precision_warning": {"anyOf": [{"$ref": "#/components/schemas/PrecisionWarning"}, {"type": "null"}]}, "history": {"items": {"type": "integer"}, "type": "array", "title": "History"}, "done_statuses": {"items": {"type": "string"}, "type": "array", "title": "Done Statuses", "default": []}, "flow_metrics": {"anyOf": [{"$ref": "#/components/schemas/FlowMetrics"}, {"type": "null"}]}}, "type": "object", "required": ["outcomes", "trials_run", "periods_used", "reference_date", "distribution", "projection", "history"], "title": "ForecastResponseBody", "description": "`ForecastResult`'s fields plus the actual per-period history used -\nwhether typed in manually or fetched from Linear - so presentation\nlayers (the web UI's charts, spec 005) can draw the burn-up/run charts\nwithout already knowing the counts client-side. Linear mode never gives\nthe frontend the raw counts the way manual paste does (spec 006), so\nthey're echoed back here instead. No change to `ForecastResult` itself\n(Constitution Principle II) - this is a web-layer-only addition.\n\n`done_statuses` names the Jira statuses the history was built from (spec 010,\nclarification Q3); it is empty for every other source. `flow_metrics` (spec 011)\nis populated for Jira-sourced requests only; `None` for every other source."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "OutcomeBucket": {"properties": {"lower": {"anyOf": [{"type": "string", "format": "date"}, {"type": "integer"}], "title": "Lower"}, "upper": {"anyOf": [{"type": "string", "format": "date"}, {"type": "integer"}], "title": "Upper"}, "trials": {"type": "integer", "minimum": 0.0, "title": "Trials"}}, "type": "object", "required": ["lower", "upper", "trials"], "title": "OutcomeBucket", "description": "One bar of the outcome distribution (spec 005 data-model.md)."}, "PrecisionWarning": {"properties": {"message": {"type": "string", "title": "Message"}}, "type": "object", "required": ["message"], "title": "PrecisionWarning", "description": "Advisory flag: a forecast's outcome spread is too wide to plan against.\n\nPresent only when the computed spread-to-center ratio exceeds the\nconfirmed threshold (research.md \u00a71/\u00a72) - never a hard gate, always\nadditive to the forecast it accompanies (Constitution Principle IV)."}, "ProjectionPoint": {"properties": {"period": {"type": "integer", "minimum": 1.0, "title": "Period"}, "period_end": {"type": "string", "format": "date", "title": "Period End"}, "cumulative": {"additionalProperties": {"type": "integer"}, "type": "object", "title": "Cumulative"}}, "type": "object", "required": ["period", "period_end", "cumulative"], "title": "ProjectionPoint", "description": "One future period of the burn-up fan (spec 005 data-model.md)."}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}, "WipSnapshot": {"properties": {"key": {"type": "string", "title": "Key"}, "started_at": {"type": "string", "format": "date", "title": "Started At"}, "age_days": {"type": "integer", "minimum": 0.0, "title": "Age Days"}}, "type": "object", "required": ["key", "started_at", "age_days"], "title": "WipSnapshot", "description": "One currently-in-progress Jira issue's age as of today (spec 011)."}}}}
